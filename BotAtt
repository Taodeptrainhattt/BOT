const mineflayer = require('mineflayer');
const readline   = require('readline');
const { pathfinder, Movements, goals } = require('mineflayer-pathfinder');

// CONFIG
const HOST     = 'mc.minerua.com';
const PORT     = 25565;
const VERSION  = '1.21.4';
const USERNAME = '_Ci'; 
const PASSWORD = 'nguyentrungtinh0102';

// Lệnh vô / vô lại dungeon - chỉnh 1 chỗ này là áp dụng cho mọi nơi
const CMD_VO_DUNGEON = '/warp dungeon1';

// Bán kính (khối) quét quái / BOSS - tăng lên nếu phòng dungeon rộng
const BAN_KINH_TIM_QUAI = 20;
const BAN_KINH_TIM_BOSS = 28;

// 3 loại đèn ếch (froglight) dùng khi boss bar báo "Bảo vệ trái tim của hầm ngục"
const TEN_DEN_ECH = ['ochre_froglight', 'verdant_froglight', 'pearlescent_froglight'];
const BAN_KINH_TIM_DEN_ECH = 64;
const KHOANG_CACH_DUNG_CANH_DEN_ECH = 1; // đứng cách đèn ếch xa nhất 1 block

// Tổng % tốc độ cộng dồn từ skill MMO của server (vd "Cung Thủ") — server
// KHÔNG gửi số này qua bất kỳ gói tin mạng nào (đã kiểm chứng qua log thật:
// không qua attribute, effect, velocity hay position) nên bot không thể tự
// đọc được, phải khai báo thủ công đúng số thật đọc trong GUI skill.
// Cách tính: cấp hiện tại × chỉ số "Tốc Độ: +x/cấp" hiển thị trong GUI.
// VD: cấp 459, +3.0E-4/cấp -> 459 * 0.0003 = 0.1377 (tức +13.77%).
// ⚠️ PHẢI TỰ CẬP NHẬT LẠI SỐ NÀY mỗi khi skill lên cấp, bot không tự biết.
const TOC_DO_TU_SKILL_MMO = 459 * 0.0003; // = 0.1377 -> đổi 459 thành cấp thật hiện tại của bạn

const C = { green: '\x1b[32m', cyan: '\x1b[36m', yellow: '\x1b[33m', red: '\x1b[31m', reset: '\x1b[0m' };

process.on('uncaughtException', err => { if (err.code !== 'EPIPE' && err.name !== 'PartialReadError') console.error('Lỗi:', err.message); });
process.on('unhandledRejection', r => {});

const sleep = ms => new Promise(res => setTimeout(res, ms));
const rand  = (a, b) => Math.floor(Math.random() * (b - a + 1)) + a;

let activeBot = null;
const rl = readline.createInterface({ input: process.stdin, terminal: false });
rl.on('line', l => { if (l.trim() && activeBot) activeBot.chat(l.trim()); });

function startBot(delay = 0) {
  setTimeout(() => {
    console.log(`[${USERNAME}] Start Lite...`);

    const bot = mineflayer.createBot({ host: HOST, port: PORT, username: USERNAME, version: VERSION, auth: 'offline', checkTimeoutInterval: 60000, keepAlive: true, hideErrors: true });
    bot.loadPlugin(pathfinder);
    activeBot = bot;
    bot.setMaxListeners(50);

    let done = false, guiBusy = false, phase = 'init', ignoreChat = false;
    let balInt = null;

    // --- Trạng thái riêng cho KHỞI ĐỘNG / farm ---
    let farmActive = false;             // vòng farm đang chạy hay không
    let coThongBaoThucTinh = false;     // đã thấy dòng "Hãy hoàn thành thức tỉnh..." chưa
    let dangXuLySuKienDungeon = false;  // chặn xử lý trùng khi 1 thông báo in ra nhiều dòng

    // --- Trạng thái riêng cho pha "Bảo vệ trái tim của hầm ngục" (boss bar) ---
    let dangBaoVeTraiTim = false;       // boss bar hiện tại có đang hiển thị dòng này không
    let dangXuLyBaoVeTraiTim = false;   // đang trong luồng xử lý (chặn gọi trùng)
    let viTriDenEchHienTai = null;

    let nhayLienTucInt = null;
    let vaTocDoInt = null;
    let tpaCheckInt = null;
    let tafCheckInt = null;
    let dangXuLyBiKickDungeon = false;
    let dangXuLyBatTaf = false;

    const log = msg => console.log(`[${USERNAME}] ${msg}`);

    // ============================================================
    //  NHẢY LIÊN TỤC KHI DI CHUYỂN (áp dụng cho MỌI kiểu di chuyển:
    //  pathfinder farm, đuổi quái, đi tìm quái, v.v. — không riêng
    //  lúc chạy tới đánh). Cứ ~650ms kiểm tra 1 lần: nếu bot đang thực
    //  sự di chuyển (có control forward, hoặc pathfinder đang có goal,
    //  và vận tốc ngang > 0 thật sự chứ không phải đứng yên/bị kẹt)
    //  thì nhích 1 nhịp nhảy. Chỉ cần gọi 1 lần lúc khởi động.
    // ============================================================
    function batDauNhayKhiDiChuyen() {
      if (nhayLienTucInt) return;
      nhayLienTucInt = setInterval(() => {
        if (done || !bot.entity) return;
        const coGoalPathfinder = !!(bot.pathfinder && bot.pathfinder.goal);
        const dangDiChuyen = (bot.controlState && bot.controlState.forward) || coGoalPathfinder;
        if (!dangDiChuyen) return;

        const v = bot.entity.velocity;
        const tocDoNgang = Math.sqrt(v.x * v.x + v.z * v.z);
        if (tocDoNgang > 0.02) {
          bot.setControlState('jump', true);
          setTimeout(() => { if (!done) bot.setControlState('jump', false); }, 200);
        }
      }, 650);
    }

    // ============================================================
    //  DEBUG TỐC ĐỘ: đo khoảng cách di chuyển thật (theo mặt phẳng
    //  ngang, dựa trên bot.entity.position, KHÔNG suy ra từ velocity)
    //  mỗi giây, in ra block/s thật đang chạy. In kèm attribute
    //  "movement_speed" (nếu server có gửi qua attribute chuẩn) và
    //  danh sách hiệu ứng (potion effect) đang có, để xác định buff
    //  tốc độ của server đến từ đâu:
    //  - Nếu attribute/effect CÓ tăng lên nhưng block/s vẫn thấp ->
    //    lỗi nằm ở việc mineflayer không áp dụng đúng giá trị đó vào
    //    mô phỏng vật lý cục bộ -> cần tự cộng thêm tốc độ thủ công.
    //  - Nếu attribute/effect KHÔNG hề đổi dù ngoài đời đang chạy
    //    nhanh -> buff không đến qua attribute/effect chuẩn (có thể
    //    qua gói tin khác, vd player_abilities chỉnh thẳng walk
    //    speed) -> cần xử lý theo hướng khác.
    // ============================================================
    const CHU_KY_DEBUG_TOC_DO = 1000; // ms
    let debugTocDoInt = null;
    let viTriTruocDoDebug = null;

    function layAttributeTocDo() {
      const attrs = (bot.entity && bot.entity.attributes) || {};
      const key = Object.keys(attrs).find(k => k.toLowerCase().includes('movement_speed') || k.toLowerCase().includes('movementspeed'));
      return key ? attrs[key] : null;
    }

    function batDauDebugTocDo() {
      if (debugTocDoInt) return;
      viTriTruocDoDebug = bot.entity ? bot.entity.position.clone() : null;
      debugTocDoInt = setInterval(() => {
        if (done || !bot.entity) return;
        const viTriHienTai = bot.entity.position;
        if (viTriTruocDoDebug) {
          const dx = viTriHienTai.x - viTriTruocDoDebug.x;
          const dz = viTriHienTai.z - viTriTruocDoDebug.z;
          const quangDuong = Math.sqrt(dx * dx + dz * dz);
          const tocDo = quangDuong / (CHU_KY_DEBUG_TOC_DO / 1000);
          const attrTocDo = layAttributeTocDo();
          const hieuUng = bot.entity.effects || {};
          log(`[TỐC ĐỘ] ${tocDo.toFixed(2)} block/s | sprint=${!!(bot.controlState && bot.controlState.sprint)} | ` +
              `attribute_toc_do=${attrTocDo ? JSON.stringify(attrTocDo) : 'không có'} | hieu_ung=${JSON.stringify(hieuUng)}`);
        }
        viTriTruocDoDebug = viTriHienTai.clone();
      }, CHU_KY_DEBUG_TOC_DO);
    }

    function recon(rsn) {
      if (done) return;
      done = true;
      if (balInt) clearInterval(balInt);
      if (nhayLienTucInt) clearInterval(nhayLienTucInt);
      if (debugTocDoInt) clearInterval(debugTocDoInt);
      if (vaTocDoInt) clearInterval(vaTocDoInt);
      if (tpaCheckInt) clearInterval(tpaCheckInt);
      if (tafCheckInt) clearInterval(tafCheckInt);
      activeBot = null;
      log(`Recon: ${rsn}`);
      try { bot.end(); } catch(_) {}
      bot.removeAllListeners();
      if (bot._client) bot._client.removeAllListeners();
      startBot(2000);
    }

    async function joinSky() {
      return new Promise(res => {
        phase = 'skyMenu';
        bot.chat('/sky');
        const h = async w => {
          if (phase !== 'skyMenu' || guiBusy) return;
          guiBusy = true;
          try {
            await sleep(rand(1000, 1400));
            await bot.clickWindow(13, 0, 0);
            phase = 'skyUpdated';
            await sleep(1500);
            if (bot.currentWindow && phase === 'skyUpdated') {
              await bot.clickWindow(19, 0, 0);
              phase = 'joined';
              await sleep(500);
              if (bot.currentWindow) bot.closeWindow(bot.currentWindow);
              res();
            }
          } catch (e) { res(); } finally { guiBusy = false; }
        };
        bot.once('windowOpen', h);
        setTimeout(() => { bot.removeListener('windowOpen', h); res(); }, 15000);
      });
    }

    // ============================================================
    //  KHỞI ĐỘNG
    //  FIX: coThongBaoThucTinh không còn được reset mỗi vòng lặp nữa
    //  (server chỉ gửi dòng "Hãy hoàn thành thức tỉnh..." MỘT LẦN khi
    //  vừa vô ải, không lặp lại mỗi 2.5s, nên yêu cầu nó true trong
    //  từng vòng lặp khiến bot luôn báo "không có quái" dù có quái
    //  thật ở gần). Giờ chỉ cần tìm THẤY quái là đủ điều kiện.
    // ============================================================

    // ============================================================
    //  KIỂM TRA BỊ KICK KHỎI DUNGEON (qua /tpa mỗi 30s)
    //  Nếu chat trả lời "can't use /tpa" -> coi như đã bị kick khỏi
    //  dungeon, vô lại dungeon và Khởi Động lại từ đầu.
    // ============================================================
    async function xuLyBiKickKhoiDungeon() {
      if (done || dangXuLyBiKickDungeon) return;
      dangXuLyBiKickDungeon = true;
      log('Phát hiện bị kick khỏi dungeon (qua /tpa) -> vô lại dungeon và Khởi Động lại.');
      farmActive = false;
      try { bot.pathfinder.setGoal(null); } catch (e) {}
      bot.clearControlStates();
      await voDungeon();
      await khoiDong();
      dangXuLyBiKickDungeon = false;
    }

    // ============================================================
    //  LISTENER CHUNG: bất kỳ lúc nào chat xuất hiện chữ "Bật!" (không
    //  riêng lúc gửi /taf autofarm) -> chờ 5s rồi gửi /taf triggerbot.
    // ============================================================
    async function xuLyBatTaf() {
      if (done || dangXuLyBatTaf) return;
      dangXuLyBatTaf = true;
      await sleep(5000);
      if (!done) bot.chat('/taf triggerbot');
      dangXuLyBatTaf = false;
    }

    // ============================================================
    //  KIỂM TRA /taf autofarm MỖI 60s
    //  Gửi /taf autofarm, chờ xem chat có chữ "Bật!" xuất hiện trong ~3s hay
    //  không:
    //  - Có "Bật!" -> đã có listener chat chung (xuLyBatTaf) tự lo phần
    //    chờ 5s rồi gửi /taf triggerbot, hàm này không cần làm gì thêm.
    //  - Không có "Bật!" -> gửi /taf triggerbot ngay (không chờ).
    // ============================================================
    async function chuKyKiemTraTaf() {
      if (done) return;
      bot.chat('/taf autofarm');

      const coBat = await new Promise(resolve => {
        let xong = false;
        const h = msg => {
          if (xong) return;
          const clean = msg.toString().replace(/§[0-9a-fklmnor]/gi, '');
          if (clean.includes('tắt.')) {
            xong = true;
            bot.removeListener('message', h);
            resolve(true);
          }
        };
        bot.on('message', h);
        setTimeout(() => {
          if (xong) return;
          xong = true;
          bot.removeListener('message', h);
          resolve(false);
        }, 3000);
      });

      if (done) return;
      if (!coBat) bot.chat('/taf triggerbot');
    }

    async function khoiDong() {
      if (done) return;
      phase = 'khoiDong';
      log('=== KHỞI ĐỘNG ===');

      bot.physics.enabled = true;
      try {
        const movements = new Movements(bot);
        movements.allowSprinting = true; // chạy (sprint) thay vì đi bộ thường -> đúng tốc độ tối đa
        movements.allowParkour = true;   // cho phép nhảy qua vật cản/hố nhỏ khi di chuyển
        bot.pathfinder.setMovements(movements);
      } catch (e) {}

      // Bật sprint 1 lần, giữ nguyên suốt phiên (bật/tắt liên tục mỗi lần
      // đổi hàm di chuyển trước đây gây khựng, giảm tốc trung bình).
      bot.setControlState('sprint', true);
      batDauNhayKhiDiChuyen();
      batDauDebugTocDo();

      // 2 vòng kiểm tra định kỳ mới — chỉ khởi động 1 lần (khoiDong có thể
      // được gọi lại nhiều lần), tất cả đều nằm sau đoạn joined như yêu cầu.
      if (!tpaCheckInt) {
        tpaCheckInt = setInterval(() => { if (!done) bot.chat('/tpa'); }, 30000);
      }
      if (!tafCheckInt) {
        tafCheckInt = setInterval(() => { if (!done) chuKyKiemTraTaf(); }, 60000);
      }

      await voDungeon();       // vô dungeon lần đầu (/warp dungeon1)
      bot.chat('/taf triggerbot');
      await sleep(rand(1500, 2000));
      coThongBaoThucTinh = false; // reset 1 lần khi mới vô, không reset mỗi vòng lặp

      let coQuai = false;

      while (!done && !coQuai) {
        await sleep(1000);
        await nhaySoTaiCho(1500);

        const quaiGanNhat = timQuaiGanNhat(BAN_KINH_TIM_QUAI);

        if (!quaiGanNhat) {
          log('Chưa thấy quái, chọn hướng đi tìm...');
          debugDanhSachEntity(BAN_KINH_TIM_QUAI);
          const timThay = await diChuyenNgauNhienVaTimQuai(5000);

          if (timThay) {
            coQuai = true;
            log('Đã phát hiện quái!');
          } else {
            log('Không có quái, vô lại dungeon...');
            await voDungeon();
            coThongBaoThucTinh = false; // reset lại vì vừa vô ải mới
          }
        } else {
          coQuai = true;
          log(`Đã có quái sẵn (${getTenTuyChinh(quaiGanNhat) || quaiGanNhat.name || quaiGanNhat.type}), bắt đầu farm!`);
        }
      }

      if (!done) batDauFarm();
    }

    // Nhảy tại chỗ trong `thoiGian` ms
    async function nhaySoTaiCho(thoiGian) {
      bot.clearControlStates();
      const ketThuc = Date.now() + thoiGian;
      while (Date.now() < ketThuc && !done) {
        bot.setControlState('jump', true);
        await sleep(200);
        bot.setControlState('jump', false);
        await sleep(150);
      }
      bot.setControlState('jump', false);
    }

    // Chọn bừa 1 hướng, đi tối đa `thoiGian` ms, vừa đi vừa quét quái
    // quanh mình. Thấy quái là dừng đi lung tung và chạy tới đánh luôn.
    // (Việc nhảy trong lúc chạy do bộ đếm toàn cục batDauNhayKhiDiChuyen lo,
    // áp dụng cho MỌI kiểu di chuyển chứ không riêng hàm này.)
    async function diChuyenNgauNhienVaTimQuai(thoiGian) {
      if (!bot.entity) return false;

      const goc = Math.random() * Math.PI * 2;
      const diemNhin = bot.entity.position.offset(Math.cos(goc) * 20, 0, Math.sin(goc) * 20);

      try { bot.lookAt(diemNhin, true); } catch (e) {}
      bot.setControlState('forward', true);

      const ketThuc = Date.now() + thoiGian;
      let quaiTimThay = null;

      while (Date.now() < ketThuc && !done) {
        await sleep(300);
        quaiTimThay = timQuaiGanNhat(BAN_KINH_TIM_QUAI);
        if (quaiTimThay) break;
      }

      bot.setControlState('forward', false);

      if (quaiTimThay) {
        await diChuyenToiVaDanhQuai(quaiTimThay);
        return true;
      }
      return false;
    }

    // Vô dungeon / vô lại dungeon bằng lệnh riêng.
    async function voDungeon() {
      if (done) return;
      bot.chat(CMD_VO_DUNGEON);
      await sleep(rand(1500, 2000));
    }

    // ============================================================
    //  FARM
    // ============================================================

    async function batDauFarm() {
      if (done || farmActive) return;
      phase = 'farming';
      farmActive = true;
      log('Bắt đầu farm.');
      farmLoop();
    }

    async function farmLoop() {
      while (!done && farmActive) {
        const boss = timBossGanNhat(BAN_KINH_TIM_BOSS);
        const mucTieu = boss || timQuaiGanNhat(BAN_KINH_TIM_QUAI);

        if (!mucTieu) {
          await sleep(300);
          continue;
        }

        if (boss) log(`Phát hiện BOSS (${getTenTuyChinh(boss)}) -> chạy tới đánh ngay.`);

        await diChuyenToiVaDanhQuai(mucTieu, () => {
          if (!isBossEntity(mucTieu)) return !!timBossGanNhat(BAN_KINH_TIM_BOSS);
          return false;
        });

        await sleep(200);
      }
    }

    // Cố đọc HP hiện tại/tối đa nếu tên quái hiển thị dạng "... 12/50 ..."
    // hoặc "...[12/50]..." (phổ biến ở server RPG custom mob).
    function layMauQuaTen(e) {
      const ten = getTenTuyChinh(e);
      if (!ten) return null;
      const m = ten.match(/(\d+(?:\.\d+)?)\s*\/\s*(\d+(?:\.\d+)?)/);
      if (!m) return null;
      return { hienTai: parseFloat(m[1]), toiDa: parseFloat(m[2]) };
    }

    // Check "còn sống" thật sự, theo thứ tự ưu tiên:
    // 1) Entity đã biến mất khỏi world -> chắc chắn chết.
    // 2) Máu đọc được từ tên (kiểu server RPG hiện HP trong nametag) -> dùng cái này làm chuẩn.
    // 3) Field health chuẩn của LivingEntity (mineflayer tự parse từ metadata) nếu có.
    // 4) Không có tín hiệu nào -> coi như còn sống (chỉ dừng khi entity biến mất hoặc hết giờ an toàn).
    // LƯU Ý: cách (2) phụ thuộc format tên thật của server bạn; nếu không đúng dạng
    // "hiện/tối đa", gửi mình 1 ví dụ tên quái lúc đang bị đánh để chỉnh lại regex.
    function quaiConSong(e) {
      if (!e || !bot.entities[e.id]) return false;

      const mau = layMauQuaTen(e);
      if (mau) return mau.hienTai > 0;

      if (typeof e.health === 'number') return e.health > 0;

      return true;
    }

    async function diChuyenToiVaDanhQuai(quai, kiemTraHuyGiuaChung) {
      if (!quai) return;
      try { bot.pathfinder.setGoal(new goals.GoalFollow(quai, 2), true); } catch (e) {}

      const batDau = Date.now();

      while (!done && bot.entities[quai.id]) {
        if (kiemTraHuyGiuaChung && kiemTraHuyGiuaChung()) break;

        if (!quaiConSong(quai)) {
          log(`Quái đã hết máu (${getTenTuyChinh(quai) || quai.name || quai.type}) -> dừng đánh, tìm mục tiêu khác.`);
          break;
        }

        const khoangCach = bot.entity.position.distanceTo(quai.position);
        if (khoangCach <= 3.5) {
          try { bot.lookAt(quai.position.offset(0, 1.2, 0), true); } catch (e) {}
          bot.attack(quai);
          await sleep(450); // ~tốc độ đánh 1 vũ khí thường, chỉnh lại nếu vũ khí đánh nhanh/chậm hơn
        } else {
          await sleep(400);
        }

        if (Date.now() - batDau > 20000) break; // an toàn, tránh kẹt vô hạn với 1 con quái
      }

      try { bot.pathfinder.setGoal(null); } catch (e) {}
    }

    // ============================================================
    //  BOSS BAR: "Bảo vệ trái tim của hầm ngục"
    //  - Khi boss bar hiện dòng này: tạm dừng farm, tìm 1 trong 3
    //    loại đèn ếch (froglight) gần nhất, di chuyển tới đứng cách
    //    nó xa nhất 1 block và đứng yên tại đó.
    //  - Khi boss bar đổi nội dung/biến mất: quay lại farm bình thường.
    //  GIẢ ĐỊNH: server gửi dòng này qua boss bar thật (packet
    //  boss_bar) nên dùng sự kiện bossBarCreated/Updated của
    //  mineflayer. Nếu bot không bắt được, log bossBar thô ra để
    //  kiểm tra cấu trúc thật rồi chỉnh lại laBossBarBaoVeTraiTim().
    // ============================================================

    function laBossBarBaoVeTraiTim(bossBar) {
      try {
        let text = '';
        if (bossBar && bossBar.title) {
          text = typeof bossBar.title.toString === 'function'
            ? bossBar.title.toString()
            : chatComponentToText(bossBar.title);
        }
        return text.toLowerCase().includes('bảo vệ trái tim của hầm ngục');
      } catch (e) { return false; }
    }

    // Tìm 1 trong 3 loại đèn ếch gần nhất và ra lệnh pathfinder di
    // chuyển tới đứng cách nó xa nhất KHOANG_CACH_DUNG_CANH_DEN_ECH block.
    async function diToiDenEchGanNhat() {
      if (!bot.entity) return null;

      let mcData;
      try { mcData = require('minecraft-data')(bot.version); } catch (e) {
        log('Không load được minecraft-data để tra id đèn ếch.');
        return null;
      }

      const idsCanTim = TEN_DEN_ECH
        .map(ten => mcData.blocksByName[ten] && mcData.blocksByName[ten].id)
        .filter(id => id !== undefined);

      if (!idsCanTim.length) {
        log('Không nhận diện được block id của đèn ếch (kiểm tra lại tên block).');
        return null;
      }

      const khoi = bot.findBlock({
        matching: b => idsCanTim.includes(b.type),
        maxDistance: BAN_KINH_TIM_DEN_ECH
      });

      if (!khoi) {
        log('Không tìm thấy đèn ếch nào trong bán kính gần.');
        return null;
      }

      log(`Tìm thấy đèn ếch tại (${khoi.position.x}, ${khoi.position.y}, ${khoi.position.z}) -> di chuyển tới đứng cạnh (≤${KHOANG_CACH_DUNG_CANH_DEN_ECH} block).`);
      try {
        bot.pathfinder.setGoal(new goals.GoalNear(
          khoi.position.x, khoi.position.y, khoi.position.z,
          KHOANG_CACH_DUNG_CANH_DEN_ECH
        ));
      } catch (e) {}

      return khoi.position;
    }

    // Luồng xử lý chính: tạm dừng farm, đứng cạnh đèn ếch cho tới khi
    // boss bar không còn hiện dòng "Bảo vệ trái tim..." nữa.
    async function xuLyBaoVeTraiTim() {
      if (dangXuLyBaoVeTraiTim) return;
      dangXuLyBaoVeTraiTim = true;
      log('Boss bar: "Bảo vệ trái tim của hầm ngục" -> tạm dừng farm, tìm đèn ếch để đứng cạnh.');

      const dangFarmTruocDo = farmActive;
      farmActive = false;
      try { bot.pathfinder.setGoal(null); } catch (e) {}

      viTriDenEchHienTai = await diToiDenEchGanNhat();

      while (!done && dangBaoVeTraiTim) {
        if (viTriDenEchHienTai) {
          const kc = bot.entity.position.distanceTo(viTriDenEchHienTai);
          if (kc > KHOANG_CACH_DUNG_CANH_DEN_ECH + 2) {
            // lỡ bị đẩy ra xa (bị đánh văng, quái đẩy...) -> đi lại
            viTriDenEchHienTai = await diToiDenEchGanNhat();
          }
        } else {
          viTriDenEchHienTai = await diToiDenEchGanNhat();
        }
        await sleep(1000);
      }

      try { bot.pathfinder.setGoal(null); } catch (e) {}
      viTriDenEchHienTai = null;
      log('Hết pha "Bảo vệ trái tim của hầm ngục" -> quay lại farm.');
      dangXuLyBaoVeTraiTim = false;
      if (dangFarmTruocDo) batDauFarm();
    }

    function xuLyBossBarThayDoi(bossBar) {
      if (done) return;
      const canBaoVe = laBossBarBaoVeTraiTim(bossBar);
      if (canBaoVe && !dangBaoVeTraiTim) {
        dangBaoVeTraiTim = true;
        xuLyBaoVeTraiTim();
      } else if (!canBaoVe && dangBaoVeTraiTim) {
        dangBaoVeTraiTim = false; // vòng while trong xuLyBaoVeTraiTim sẽ tự thoát ở lượt kiểm tra kế tiếp
      }
    }

    const LOAI_KHONG_PHAI_QUAI = new Set([
      'item', 'arrow', 'spectral_arrow', 'trident', 'snowball', 'egg',
      'experience_orb', 'experience_bottle', 'fishing_bobber', 'firework_rocket',
      'tnt', 'falling_block', 'item_frame', 'glow_item_frame', 'painting',
      'leash_knot', 'end_crystal', 'evoker_fangs', 'block_display',
      'item_display', 'text_display', 'marker', 'boat', 'chest_boat',
      'minecart', 'chest_minecart', 'lightning_bolt'
    ]);

    function coTheLaQuai(e) {
      if (!e || e === bot.entity || !e.position) return false;
      if (e.type === 'player' || e.type === 'orb') return false;
      const ten = (e.name || '').toLowerCase();
      if (LOAI_KHONG_PHAI_QUAI.has(ten)) return false;
      return true;
    }

    function debugDanhSachEntity(banKinh = 20) {
      if (!bot.entity) return;
      const ds = Object.values(bot.entities)
        .filter(e => e && e !== bot.entity && e.position)
        .map(e => ({
          type: e.type,
          kind: e.kind,
          name: e.name,
          ten: getTenTuyChinh(e),
          kc: +bot.entity.position.distanceTo(e.position).toFixed(1)
        }))
        .filter(x => x.kc <= banKinh)
        .sort((a, b) => a.kc - b.kc);
      log(`[DEBUG] Entity trong bán kính ${banKinh}: ${JSON.stringify(ds)}`);
    }

    function timQuaiGanNhat(banKinh = BAN_KINH_TIM_QUAI) {
      if (!bot.entity) return null;
      const ds = Object.values(bot.entities).filter(e => {
        if (!coTheLaQuai(e)) return false;
        return bot.entity.position.distanceTo(e.position) <= banKinh;
      });
      if (!ds.length) return null;
      ds.sort((a, b) => bot.entity.position.distanceTo(a.position) - bot.entity.position.distanceTo(b.position));
      return ds[0];
    }

    function timBossGanNhat(banKinh = BAN_KINH_TIM_BOSS) {
      if (!bot.entity) return null;
      const ds = Object.values(bot.entities).filter(e => {
        if (!coTheLaQuai(e)) return false;
        if (!isBossEntity(e)) return false;
        return bot.entity.position.distanceTo(e.position) <= banKinh;
      });
      if (!ds.length) return null;
      ds.sort((a, b) => bot.entity.position.distanceTo(a.position) - bot.entity.position.distanceTo(b.position));
      return ds[0];
    }

    function isBossEntity(e) {
      const ten = getTenTuyChinh(e).toUpperCase();
      return ten.includes('BOSS');
    }

    // FIX: đọc tên tuỳ chỉnh (nametag) đúng vị trí metadata chuẩn
    // (index 2 = custom name, dạng optional chat component, theo spec
    // Entity base của Minecraft 1.21.x), có xử lý cả dạng wrap
    // {present, value} lẫn dạng raw, và cả trường hợp value là chuỗi
    // JSON của chat component thay vì object sẵn. Nếu index 2 trống,
    // fallback quét toàn bộ metadata như bản cũ để không bỏ sót
    // trường hợp server đặt tên ở vị trí khác.
    function chatComponentToText(comp) {
      if (!comp) return '';
      if (typeof comp === 'string') return comp;
      let s = comp.text || '';
      if (Array.isArray(comp.extra)) s += comp.extra.map(chatComponentToText).join('');
      return s;
    }

    function getTenTuyChinh(e) {
      try {
        if (e.username) return e.username;

        if (Array.isArray(e.metadata)) {
          // 1) Thử đúng vị trí chuẩn trước (index 2 = custom name)
          const raw2 = e.metadata[2];
          const val2 = (raw2 && typeof raw2 === 'object' && 'present' in raw2 && 'value' in raw2)
            ? (raw2.present ? raw2.value : null)
            : raw2;

          if (val2) {
            if (typeof val2 === 'string') {
              try {
                const parsed = JSON.parse(val2);
                const t = chatComponentToText(parsed);
                if (t.trim()) return t;
              } catch (_) {
                if (val2.trim()) return val2;
              }
            } else if (typeof val2 === 'object') {
              const t = chatComponentToText(val2);
              if (t.trim()) return t;
            }
          }

          // 2) Fallback: quét toàn bộ metadata như bản cũ, phòng khi
          // server đặt tên ở vị trí khác chuẩn
          for (const item of e.metadata) {
            if (!item) continue;
            if (typeof item === 'string' && item.trim()) return item;
            if (typeof item === 'object' && typeof item.text === 'string') {
              const t = chatComponentToText(item);
              if (t.trim()) return t;
            }
          }
        }
      } catch (err) {}
      return '';
    }

    // "Ải này không có thưởng rơi" -> vô lại ải, KHÔNG gọi lại Khởi Động
    async function xuLyKhongCoThuong() {
      if (done || dangXuLySuKienDungeon) return;
      dangXuLySuKienDungeon = true;
      log('"Ải này không có thưởng rơi" -> vô lại dungeon, KHÔNG gọi lại Khởi Động.');
      farmActive = false;
      try { bot.pathfinder.setGoal(null); } catch (e) {}
      bot.clearControlStates();
      await sleep(500);
      await voDungeon();
      batDauFarm();
      setTimeout(() => { dangXuLySuKienDungeon = false; }, 3000);
    }

    // "Phần thưởng ải" -> chờ 6s, /is, đi thẳng 3s, rồi mới vô lại dungeon và Khởi Động lại
    async function xuLyCoThuong() {
      if (done || dangXuLySuKienDungeon) return;
      dangXuLySuKienDungeon = true;
      log('"Phần thưởng ải" -> chờ 6s, /is, đi thẳng 3s, vô lại dungeon rồi Khởi Động lại.');
      farmActive = false;
      try { bot.pathfinder.setGoal(null); } catch (e) {}
      bot.clearControlStates();

      await sleep(6000);
      if (done) return;

      bot.chat('/is');

      bot.setControlState('forward', true);
      bot.setControlState('sprint', true);
      await sleep(3000);
      bot.setControlState('forward', false);
      bot.setControlState('sprint', false);

      await voDungeon();
      await khoiDong();
      setTimeout(() => { dangXuLySuKienDungeon = false; }, 3000);
    }

    bot.once('spawn', async () => {
      balInt = setInterval(() => { if (!done) bot.chat('/bal'); }, 180000);
      bot.physics.enabled = false;
      ignoreChat = true;
      setTimeout(() => { ignoreChat = false; }, 10000);

      await sleep(2000);
      if (done) return;
      bot.chat(`/login ${PASSWORD}`);
      
      await sleep(2000);
      if (done) return;
      await joinSky();

      if (done) return;
      await khoiDong();
    });

    // ============================================================
    //  VÁ LỖI TỐC ĐỘ: thư viện vật lý mineflayer dùng (prismarine-
    //  physics) tính ra mức Speed/Slowness (this.speed/this.slowness)
    //  nhưng KHÔNG hề dùng chúng để tính vận tốc — nó chỉ đọc attribute
    //  "minecraft:movement_speed" mà server gửi (ở server này gửi giá
    //  trị 0) cộng bonus sprint. Vì vậy Speed III thật sự KHÔNG được
    //  áp dụng vào việc bot di chuyển dù bot đang có hiệu ứng đó.
    //  Fix: tự tính lại attribute này y hệt công thức vanilla thật
    //  (client Minecraft gốc tự làm việc này mỗi khi effect thay đổi):
    //  Speed: nhân tổng dồn +20% mỗi cấp (amplifier+1).
    //  Slowness: nhân tổng dồn -15% mỗi cấp, không cho xuống dưới 0.
    // ============================================================
    const KEY_ATTR_TOC_DO = 'minecraft:movement_speed';
    const UUID_MOD_SPEED = '91aeaa56-376b-4498-935b-2f7f68070635';
    const UUID_MOD_SLOWNESS = '7107de5e-7ce8-4030-940e-514c1f160890';
    const UUID_MOD_VAT_PHAM = 'a1b2c3d4-e5f6-4a1b-8c9d-1234567890ab'; // UUID tự đặt, chỉ dùng nội bộ để lọc/thay thế
    const UUID_MOD_SKILL_MMO = 'b2c3d4e5-f6a7-4b2c-9d0e-234567890abc'; // UUID tự đặt cho phần bonus skill MMO
    const BASE_TOC_DO_VANILLA = 0.1; // base chuẩn của player khi đi bộ

    // Đọc chỉ số "Movement Speed: +N" thật trong lore của vật phẩm đang
    // cầm (dữ liệu có thật của chính item, không phải suy đoán) và quy
    // đổi thành phần trăm cộng dồn (N=3 -> 0.03), khớp đúng với giá trị
    // MMOITEMS_MOVEMENT_SPEED trong NBT thật của item.
    function layMovementSpeedTuVatPhamDangCam() {
      try {
        const item = bot.heldItem;
        const lore = item && item.customLore;
        if (!Array.isArray(lore)) return 0;
        for (const dong of lore) {
          const chu = chatComponentToText(dong);
          const m = chu.match(/Movement Speed:\s*\+?(-?\d+(?:\.\d+)?)/i);
          if (m) return parseFloat(m[1]) / 100;
        }
      } catch (e) {}
      return 0;
    }

    function capNhatAttributeTocDoTheoHieuUng() {
      if (!bot.entity) return;
      const effects = bot.entity.effects || {};
      const capSpeed = effects[0] ? effects[0].amplifier + 1 : 0;    // id 0 = Speed
      const capSlowness = effects[1] ? effects[1].amplifier + 1 : 0; // id 1 = Slowness
      const boSuaTuVatPham = layMovementSpeedTuVatPhamDangCam();      // vd 0.03 = +3%

      const attrHienTai = bot.entity.attributes && bot.entity.attributes[KEY_ATTR_TOC_DO];
      // Nếu server gửi base = 0 (bất thường, không dùng được để đi lại) thì
      // dùng base chuẩn vanilla; giữ nguyên base nếu server gửi giá trị hợp lý.
      const baseGoc = attrHienTai && attrHienTai.value > 0 ? attrHienTai.value : BASE_TOC_DO_VANILLA;

      // Giữ lại các modifier khác (nếu có, vd modifier gốc từ server) trừ 4
      // modifier do chính hàm này thêm vào trước đó -> tránh cộng dồn sai.
      const modifiersKhac = ((attrHienTai && attrHienTai.modifiers) || []).filter(
        m => m.uuid !== UUID_MOD_SPEED && m.uuid !== UUID_MOD_SLOWNESS &&
             m.uuid !== UUID_MOD_VAT_PHAM && m.uuid !== UUID_MOD_SKILL_MMO
      );

      const modifiersMoi = [...modifiersKhac];
      if (capSpeed > 0) {
        modifiersMoi.push({ uuid: UUID_MOD_SPEED, amount: 0.2 * capSpeed, operation: 2 });
      }
      if (capSlowness > 0) {
        modifiersMoi.push({ uuid: UUID_MOD_SLOWNESS, amount: Math.max(-1, -0.15 * capSlowness), operation: 2 });
      }
      if (boSuaTuVatPham !== 0) {
        modifiersMoi.push({ uuid: UUID_MOD_VAT_PHAM, amount: boSuaTuVatPham, operation: 2 });
      }
      if (TOC_DO_TU_SKILL_MMO !== 0) {
        modifiersMoi.push({ uuid: UUID_MOD_SKILL_MMO, amount: TOC_DO_TU_SKILL_MMO, operation: 2 });
      }

      if (!bot.entity.attributes) bot.entity.attributes = {};
      bot.entity.attributes[KEY_ATTR_TOC_DO] = { value: baseGoc, modifiers: modifiersMoi };
    }

    // Chạy định kỳ để chắc ăn (phòng khi bỏ lỡ sự kiện effect nào đó),
    // ngoài việc gọi ngay mỗi khi effect thay đổi ở các listener bên dưới.
    vaTocDoInt = setInterval(() => { if (!done) capNhatAttributeTocDoTheoHieuUng(); }, 1000);
    bot.on('heldItemChanged', () => { if (!done) capNhatAttributeTocDoTheoHieuUng(); });

    bot.on('bossBarCreated', xuLyBossBarThayDoi);
    bot.on('bossBarUpdated', xuLyBossBarThayDoi);
    bot.on('bossBarDeleted', () => { dangBaoVeTraiTim = false; });

    // Log đối chiếu: hiệu ứng mới xuất hiện/hết + thời điểm bot bị đánh
    // trúng, để xác nhận Slowness/Weakness/Hunger có phải do quái đánh
    // trúng gây ra hay không (so thời gian giữa 2 dòng log này).
    // Bắt gói tin THÔ (không qua lớp trừu tượng của mineflayer) để xem
    // server có đẩy tốc độ cho bot qua velocity hoặc ép vị trí thẳng
    // (teleport) hay không — vì đã xác nhận KHÔNG qua attribute/effect
    // chuẩn. Chỉ log khi entityId trùng với bot (bỏ qua entity khác).
    bot._client.on('entity_velocity', packet => {
      if (!bot.entity || packet.entityId !== bot.entity.id) return;
      log(`[GÓI VELOCITY CHO BOT] x=${packet.velocity.x} y=${packet.velocity.y} z=${packet.velocity.z}`);
    });
    bot._client.on('position', packet => {
      log(`[GÓI POSITION ÉP BỞI SERVER] x=${packet.x.toFixed(2)} y=${packet.y.toFixed(2)} z=${packet.z.toFixed(2)} dx=${!!(packet.flags & 1)} dy=${!!(packet.flags & 2)} dz=${!!(packet.flags & 4)}`);
    });

    bot.on('entityHurt', entity => {
      if (done || !bot.entity || !entity || entity.id !== bot.entity.id) return;
      log('[BOT BỊ ĐÁNH TRÚNG]');
    });
    bot.on('entityEffect', (entity, effect) => {
      if (done || !bot.entity || !entity || entity.id !== bot.entity.id) return;
      log(`[HIỆU ỨNG MỚI] id=${effect.id} amplifier=${effect.amplifier} duration=${effect.duration}`);
      capNhatAttributeTocDoTheoHieuUng();
    });
    bot.on('entityEffectEnd', (entity, effect) => {
      if (done || !bot.entity || !entity || entity.id !== bot.entity.id) return;
      log(`[HIỆU ỨNG HẾT] id=${effect.id}`);
      capNhatAttributeTocDoTheoHieuUng();
    });

    bot.on('windowOpen', w => {
      if (done || guiBusy || phase === 'skyMenu' || phase === 'skyUpdated') return;
      bot.closeWindow(w);
    });

    bot.on('message', async msg => {
      if (done) return;
      const clean = msg.toString().replace(/§[0-9a-fklmnor]/gi, '').trim();
      if (!clean) return;

      if (clean.includes('Câu lệnh không tồn tại')) {
        recon('Lobby');
        return;
      }
      
      if (clean.includes('❤')) return;

      if (clean.includes('Hãy hoàn thành thức tỉnh để tham gia cuộc chinh phạt')) {
        coThongBaoThucTinh = true;
      }
      if (clean.includes('Ải này không có thưởng rơi')) {
        xuLyKhongCoThuong();
      }
      if (clean.includes('Phần thưởng ải')) {
        xuLyCoThuong();
      }
      if (clean.toLowerCase().includes("can't use /tpa")) {
        xuLyBiKickKhoiDungeon();
      }
      if (clean.includes('tắt.')) {
        xuLyBatTaf();
      }

      if (ignoreChat) return;
      log(clean);
    });

    bot.on('resourcePack', (u, h) => {
      bot._client.write('resource_pack_receive', { uuid: h, result: 0 });
      setTimeout(() => { if (!done) bot._client.write('resource_pack_receive', { uuid: h, result: 3 }); }, 3000);
    });
    bot._client.on('resource_pack_push', d => {
      bot._client.write('resource_pack_receive', { uuid: d.uuid, result: 0 });
      setTimeout(() => { if (!done) bot._client.write('resource_pack_receive', { uuid: d.uuid, result: 3 }); }, 3000);
    });

    bot.on('end', rsn => { if (!done) recon(rsn); });
    bot.on('error', err => {
      if (err.code !== 'EPIPE' && err.name !== 'PartialReadError') log(`Lỗi: ${err.message}`);
    });

  }, delay);
}

startBot();
