function sendDiscordWebhook(content) {
  try {
    const url = new URL(DISCORD_WEBHOOK_URL);
    const payload = JSON.stringify({
      content,
      allowed_mentions: { parse: ['users'] }
    });
    const req = https.request({
      hostname: url.hostname,
      path: url.pathname + url.search,
      method: 'POST',
      headers: {
        'Content-Type': 'application/json',
        'Content-Length': Buffer.byteLength(payload)
      }
    }, res => { res.on('data', () => {}); });
    req.on('error', () => {});
    req.write(payload);
    req.end();
  } catch (e) {}
}

// Kiểm tra tin nhắn có phải chính người chơi "name" đang nói không, dạng "... name : nội dung"
// (server thường chèn rank/tag phía trước tên nên không neo ở đầu dòng)
function isSpeaking(clean, name) {
  const escaped = name.replace(/[-/\\^$*+?.()|[\]{}]/g, '\\$&');
  return new RegExp(`${escaped}\\s*:`).test(clean);
}

// Trả về nội dung cần gửi lên Discord (đã kèm tag nếu có), hoặc null nếu không cần gửi
//
// Quy tắc: chia 5 tên thành 3 nhóm (_Ci/_BachPremium chung 1 người, NT_Gamingvn/KaredMc chung 1 người, Hypnos riêng).
// Với mỗi nhóm: nếu tên trong nhóm xuất hiện trong tin nhắn NHƯNG chính là do người đó tự chat (dạng "Tên : ...")
// thì nhóm đó không tính (không gửi, không tag) - trừ khi trong CÙNG tin nhắn còn có nhóm khác được nhắc tới
// (không phải do chính người đó tự nói) thì tin nhắn vẫn được gửi, kèm tag cho nhóm được nhắc tới đó.
function buildDiscordContent(clean) {
  if (JOIN_LEAVE_REGEX.test(clean)) return null;
  if (BOT_COMMAND_REGEX.test(clean)) return null;
  if (TREASURE_CHEST_REGEX.test(clean)) return null;
  if (HYPNOS_JOIN_LEAVE_REGEX.test(clean)) return null;

  const GROUPS = [
    { names: ['_Ci', '_BachPremium'], id: DISCORD_ID_CI_BACH },
    { names: ['NT_Gamingvn', 'KaredMc'], id: DISCORD_ID_NT_KARED },
    { names: ['Hypnos'], id: null }
  ];

  const mentionIds = new Set();
  let matched = false;

  for (const group of GROUPS) {
    const hasKeyword = group.names.some(name => clean.includes(name));
    if (!hasKeyword) continue;

    const isSelfSpeaking = group.names.some(name => isSpeaking(clean, name));
    if (isSelfSpeaking) continue; // chính người trong nhóm này đang tự nói -> bỏ qua nhóm này

    matched = true;
    if (group.id) mentionIds.add(group.id);
  }

  if (!matched) return null;

  const mentionText = [...mentionIds].map(id => `<@${id}>`).join(' ');
  return mentionText ? `${mentionText}\n${clean}` : clean;
}
