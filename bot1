function startBot(username, delay = 0) {
  setTimeout(() => {
    console.log(`[${username}] Start Lite...`);

    const bot = mineflayer.createBot({ host: HOST, port: PORT, username, version: VERSION, auth: 'offline', checkTimeoutInterval: 60000, keepAlive: true, hideErrors: true });
    bot.loadPlugin(pathfinder);
    activeBots[username] = bot;
    bot.setMaxListeners(50);

    let done = false, guiBusy = false, phase = 'init';
    let balInt = null;
    let fishTimeout = null, fishing = false;
    let visiting = false; // true khi đang /is visit kyoree, tạm dừng câu để rảnh tay trade
    let following = false; // true khi đang bám theo _BachPremium

    // --- state cho Trade ---
    let tradeBusy = false;
    let lastChatTime = 0;

    const log = msg => console.log(`[${username}] ${msg}`);

    function recon(rsn) {
      if (done) return;
      done = true;
      if (balInt) clearInterval(balInt);
      clearFishTimer();
      fishing = false;
      if (activeBots[username] === bot) delete activeBots[username];
      log(`Recon: ${rsn}`);
      try { bot.end(); } catch(_) {}
      bot.removeAllListeners();
      if (bot._client) bot._client.removeAllListeners();
      startBot(username, 2000);
    }

    // ==== FISHING ====
    async function equipRod() {
      try {
        const rod = bot.inventory.items().find(i => i.name === 'fishing_rod');
        if (rod) await bot.equip(rod, 'hand');
      } catch (_) {}
    }

    function clearFishTimer() {
      if (fishTimeout) { clearTimeout(fishTimeout); fishTimeout = null; }
    }

    function armFishTimer() {
      clearFishTimer();
      fishTimeout = setTimeout(() => {
        if (done) return;
        log('Không thấy "Linh Khí" sau 5 phút, thả lại cần...');
        recast('timeout');
      }, 5 * 60 * 1000);
    }

    async function castRod() {
      if (done || visiting || following) return;
      try {
        await equipRod();
        bot.activateItem();
        fishing = true;
        log('Đã thả cần câu.');
        armFishTimer();
      } catch (e) {
        log(`Lỗi thả cần: ${e.message}`);
      }
    }

    async function recast(reason = '') {
      if (done || visiting || following) return;
      try {
        if (fishing) {
          bot.deactivateItem();
          fishing = false;
        }
        await sleep(rand(600, 1000));
        await castRod();
      } catch (e) {}
    }

    // Dừng câu hẳn (không thả lại) để rảnh tay trade / visit
    function stopFishing() {
      clearFishTimer();
      if (fishing) {
        try { bot.deactivateItem(); } catch (e) {}
        fishing = false;
      }
    }

    // /warp afk1 + /taf triggerbot để vào khu vực đó, chờ 6s, rồi bám theo (follow liên tục)
    // người chơi targetName cho tới khi nhận chat "here <targetName> dz".
    async function warpAndFollowPlayer(targetName) {
      if (done) return;
      await safeChat('/warp afk1', `Phát hiện chat back ${targetName} dz, chạy: /warp afk1`);
      await safeChat('/taf triggerbot', 'Chạy lệnh: /taolatraidep');
      await sleep(6000);
      if (done) return;

      const player = bot.players[targetName];
      if (!player || !player.entity) {
        log(`Không thấy người chơi ${targetName} ở gần, không thể bám theo.`);
        return;
      }

      try {
        bot.physics.enabled = true;
        const movements = new Movements(bot);
        bot.pathfinder.setMovements(movements);
        const goal = new goals.GoalFollow(player.entity, 2);
        following = true;
        bot.pathfinder.setGoal(goal, true); // dynamic=true -> liên tục bám theo khi mục tiêu di chuyển
        log(`Đang bám theo ${targetName} liên tục, chờ lệnh "here ${targetName} dz" để dừng và thả cần.`);
      } catch (e) {
        log(`Lỗi khi bắt đầu bám theo ${targetName}: ${e.message}`);
      }
    }

    // Dừng hẳn việc bám theo, đứng yên tại chỗ
    function stopFollow() {
      following = false;
      try { bot.pathfinder.setGoal(null); } catch (e) {}
      try { bot.pathfinder.stop(); } catch (e) {}
      bot.physics.enabled = false;
    }
    // ==== END FISHING ====

    // ==== TRADE (lấy từ file 2) ====
    async function waitChatGap() {
      const delayTime = CHAT_COMMAND_GAP_MS - (Date.now() - lastChatTime);
      if (delayTime > 0) await sleep(delayTime);
      lastChatTime = Date.now();
    }

    async function safeChat(cmd, logMsg = cmd) {
      await waitChatGap();
      log(logMsg);
      bot.chat(cmd);
    }

    function waitForWindow(timeoutMs = WINDOW_OPEN_TIMEOUT_MS) {
      return new Promise((resolve, reject) => {
        const onOpen = (win) => {
          clearTimeout(timeout);
          resolve(win);
        };
        const timeout = setTimeout(() => {
          bot.removeListener('windowOpen', onOpen);
          reject(new Error('Timeout'));
        }, timeoutMs);
        bot.once('windowOpen', onOpen);
      });
    }

    function waitForSignEditor(timeoutMs = 6000) {
      return new Promise((resolve, reject) => {
        const onOpen = (packet) => {
          clearTimeout(timeout);
          resolve(packet);
        };
        const timeout = setTimeout(() => {
          bot._client.removeListener('open_sign_entity', onOpen);
          reject(new Error('Timeout'));
        }, timeoutMs);
        bot._client.once('open_sign_entity', onOpen);
      });
    }

    function submitSignText(signPacket, text) {
      const line1 = String(text).slice(0, 30);
      const updatePacket = { location: signPacket.location, text1: line1, text2: '', text3: '', text4: '' };
      if (signPacket.isFrontText !== undefined) updatePacket.isFrontText = signPacket.isFrontText;
      bot._client.write('update_sign', updatePacket);
    }

    // Bỏ hết đồ trong người (trừ cần câu) vào các ô offer của cửa sổ trade
    async function depositItemsToTradeSlots(window, targetSlots) {
      const invStart = window.inventoryStart ?? (window.slots.length - 36);
      let slotIdx = 0;

      for (let i = invStart; i < window.slots.length; i++) {
        if (done) return;
        if (slotIdx >= targetSlots.length) break;

        const item = bot.currentWindow ? bot.currentWindow.slots[i] : null;
        if (!item) continue;
        if (item.name === 'fishing_rod') continue; // không bỏ cần câu vào

        try {
          await bot.clickWindow(i, 0, 0);
          await sleep(rand(200, 400));
          await bot.clickWindow(targetSlots[slotIdx], 0, 0);
          await sleep(rand(200, 400));
          slotIdx++;
        } catch (e) {}
      }
    }

    async function handleIncomingTrade(sender) {
      if (done) return;

      // Chỉ chấp nhận trade nếu người gửi đúng là TRADE_ALLOWED_SENDER
      if (sender !== TRADE_ALLOWED_SENDER) {
        await safeChat(`/trade deny ${sender}`, `Từ chối trade (không phải ${TRADE_ALLOWED_SENDER}): ${sender}`);
        return;
      }

      if (tradeBusy) {
        await safeChat(`/trade deny ${sender}`, `/trade deny ${sender}`);
        return;
      }

      tradeBusy = true;
      phase = 'trading';

      try {
        let windowPromise = waitForWindow(8000);
        await safeChat(`/trade accept ${sender}`);
        const tradeWindow = await windowPromise;
        if (done) return;
        await sleep(rand(600, 1000));

        await depositItemsToTradeSlots(tradeWindow, TRADE_OFFER_SLOTS);
        if (done) return;
        await sleep(rand(400, 700));

        const moneySlot = findSlotByDisplayName(tradeWindow, 'ᴛɪềɴ');
        if (moneySlot == null) {
          return;
        }

        const signPacketPromise = waitForSignEditor();
        await bot.clickWindow(moneySlot, 0, 0);
        const signPacket = await signPacketPromise;
        if (done) return;

        const stats = getScoreboardStats(bot);
        const signText = buildTradeAmountText(stats.money, 0.1);
        await sleep(rand(400, 700));
        submitSignText(signPacket, signText);

        await sleep(rand(1200, 1800));
        if (done) return;

        const confirmSlot = findSlotByDisplayName(bot.currentWindow, 'хáᴄ ɴʜậɴ ɢɪᴀᴏ ᴅịᴄʜ');
        if (confirmSlot == null) {
          return;
        }

        await bot.clickWindow(confirmSlot, 0, 0);
        await sleep(8000);
      } catch (err) {
      } finally {
        tradeBusy = false;
        phase = 'joined';
        if (bot.currentWindow) bot.closeWindow(bot.currentWindow);
        // Không tự thả cần ở đây - chỉ thả khi nhận được chat "here _BachPremium dz"
      }
    }
    // ==== END TRADE ====

    async function joinSky() {
      return new Promise(res => {
        phase = 'skyMenu';
        bot.chat('/sky');
        const h = async w => {
          if (phase !== 'skyMenu' || guiBusy) return;
          guiBusy = true;
          try {
            await sleep(rand(1000, 1400));
            await bot.clickWindow(13, 0, 0);
            phase = 'skyUpdated';
            await sleep(1500);
            if (bot.currentWindow && phase === 'skyUpdated') {
              await bot.clickWindow(19, 0, 0);
              phase = 'joined';
              await sleep(500);
              if (bot.currentWindow) bot.closeWindow(bot.currentWindow);
              res();
            }
          } catch (e) { res(); } finally { guiBusy = false; }
        };
        bot.once('windowOpen', h);
        setTimeout(() => { bot.removeListener('windowOpen', h); res(); }, 15000);
      });
