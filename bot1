function getChatMessageText(msg) {
  if (msg == null) return '';
  if (typeof msg === 'string') return msg;
  let text = msg.text || '';
  if (Array.isArray(msg.extra)) {
    for (const part of msg.extra) text += getChatMessageText(part);
  }
  return text;
}

function getScoreboardStats(bot) {
  let money = "0";
  for (let tName in bot.teamMap) {
    if (tName.includes('§')) {
      const team = bot.teamMap[tName];
      const text = (getChatMessageText(team.prefix) + getChatMessageText(team.suffix)).replace(/\s+$/, '');
      let matchMoney = text.match(/ᴍᴏɴᴇʏ:\s*([0-9\.]+[KkMmBbTt]*)/);
      if (matchMoney) money = matchMoney[1];
    }
  }
  return { money };
}

function norm(s) {
  try { return String(s).normalize('NFC'); } catch (e) { return String(s); }
}

function itemMatchesText(item, targetText) {
  if (!item) return false;
  const target = norm(targetText);
  try {
    if (item.componentMap && item.componentMap.has('custom_name')) {
      const raw = norm(JSON.stringify(item.componentMap.get('custom_name')));
      if (raw.includes(target)) return true;
    }
    if (item.nbt) {
      const raw = norm(JSON.stringify(item.nbt));
      if (raw.includes(target)) return true;
    }
    const rawAll = norm(JSON.stringify(item));
    if (rawAll.includes(target)) return true;
  } catch (e) {}
  return false;
}

function findSlotByDisplayName(window, targetName) {
  if (!window || !window.slots) return null;
  const guiEnd = window.inventoryStart ?? window.slots.length;
  for (let slot = 0; slot < guiEnd; slot++) {
    if (itemMatchesText(window.slots[slot], targetName)) return slot;
  }
  return null;
}

function buildTradeAmountText(moneyStr, buffer) {
  const match = String(moneyStr).match(/^([\d.]+)\s*([KkMmBbTt]?)$/);
  if (!match) return String(moneyStr);
  let value = parseFloat(match[1]);
  const unit = match[2] || '';
  value = Math.max(0, value - buffer);
  const text = value.toFixed(2).replace(/(\.\d*?)0+$/, '$1').replace(/\.$/, '');
  return `${text}${unit}`;
}
