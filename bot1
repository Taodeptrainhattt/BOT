        const stats = getScoreboardStats(bot);
        await safeChat(`/msg _BachPremium số tiền tôi đang có: ${stats.money}`, `Phát hiện chat money _BachPremium dz, báo tiền: ${stats.money}`);
        return;
      }

      if (clean.includes('Linh Khí')) {
        log('Phát hiện "Linh Khí", thả lại cần câu.');
        recast('linhkhi');
        return;
      }

      // Các tin nhắn/chat khác của server: vẫn được xử lý ngầm ở trên (Discord, trade, warp...)
      // nhưng không in nội dung chat gốc ra console nữa, chỉ log trạng thái của bot.
    });

    bot.on('resourcePack', (u, h) => {
      bot._client.write('resource_pack_receive', { uuid: h, result: 0 });
      setTimeout(() => { if (!done) bot._client.write('resource_pack_receive', { uuid: h, result: 3 }); }, 3000);
    });
    bot._client.on('resource_pack_push', d => {
      bot._client.write('resource_pack_receive', { uuid: d.uuid, result: 0 });
      setTimeout(() => { if (!done) bot._client.write('resource_pack_receive', { uuid: d.uuid, result: 3 }); }, 3000);
    });

    bot.on('end', rsn => { if (!done) recon(rsn); });
    bot.on('error', err => {
      if (err.code !== 'EPIPE' && err.name !== 'PartialReadError') log(`Lỗi: ${err.message}`);
    });

  }, delay);
}

ACCOUNTS.forEach((username, i) => startBot(username, i * 3000));
