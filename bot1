    bot.once('spawn', async () => {
      balInt = setInterval(() => { if (!done) bot.chat('/bal'); }, 180000);
      bot.physics.enabled = false;

      await sleep(2000);
      if (done) return;
      bot.chat(`/login ${PASSWORD}`);

