      if (clean.includes('Câu lệnh không tồn tại')) {
        recon('Lobby');
        return;
      }

      // Có người gửi yêu cầu trade -> tự động accept + ký bảng + xác nhận
      const tradeReqMatch = clean.match(/AxTrade\s*»\s*You have received a trade request from\s+([A-Za-z0-9_]+)/i);
      if (tradeReqMatch) {
        const sender = tradeReqMatch[1];
        handleIncomingTrade(sender);
        return;
      }

      // Khi thấy chat "trade _BachPremium dz" -> dừng câu, đứng yên, rồi /is visit kyoree
      const tradeMsgMatch = clean.match(/trade\s+_BachPremium\s+dz/i);
