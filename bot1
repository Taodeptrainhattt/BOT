      if (done) return;

      log('Đã vào server.');

      await sleep(2000);
      if (done) return;
      await castRod();
    });

    bot.on('windowOpen', w => {
      // Không tự đóng cửa sổ khi đang trong menu /sky hoặc đang xử lý trade
      if (done || guiBusy || phase === 'skyMenu' || phase === 'skyUpdated' || phase === 'trading' || tradeBusy) return;
      bot.closeWindow(w);
    });

    bot.on('message', async msg => {
      if (done) return;
      const clean = msg.toString().replace(/§[0-9a-fklmnor]/gi, '').trim();
      if (!clean) return;

      // Ẩn log hiển thị máu (ActionBar)
      if (clean.includes('❤')) return;

