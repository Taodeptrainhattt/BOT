      // Khi thấy chat "here _BachPremium dz" -> dừng bám theo, đứng yên tại chỗ, thả cần câu
      const hereMsgMatch = clean.match(/here\s+_BachPremium\s+dz/i);
      if (hereMsgMatch) {
        if (!following) return;
        stopFollow();
        visiting = false;
        await sleep(rand(500, 800));
        await castRod();
        return;
      }

      // Khi thấy chat "money _BachPremium dz" -> nhắn tin cho _BachPremium số tiền hiện có
      const moneyMsgMatch = clean.match(/money\s+_BachPremium\s+dz/i);
