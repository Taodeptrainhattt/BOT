const mineflayer = require('mineflayer')

// ===== CẤU HÌNH =====
const CONFIG = {
  host: 'mc.echovalley.online',
  port: 25565,
  username: 'Bot01',      
  version: '1.21.4',      
  auth: 'offline',        
  reconnectDelay: 5000,   
}

function createBot() {
  const bot = mineflayer.createBot({
    host: CONFIG.host,
    port: CONFIG.port,
    username: CONFIG.username,
    version: CONFIG.version,
    auth: CONFIG.auth,
  })

  bot.once('spawn', () => {
    console.log('[Bot] Đã spawn vào server, đứng yên tại chỗ.')

    // Đảm bảo không di chuyển: tắt hết control state
    bot.clearControlStates()

    // Nhìn thẳng để tránh trông "bất động bất thường" (tuỳ chọn)
    // bot.look(bot.entity.yaw, 0, true)
  })

  // Một số server anti-cheat sẽ kick bot đứng yên tuyệt đối quá lâu (coi là AFK).
  // Nếu cần, có thể bật đoạn dưới để bot "nhúc nhích nhẹ" định kỳ (không di chuyển vị trí xa):
  /*
  setInterval(() => {
    if (!bot.entity) return
    bot.look(bot.entity.yaw + 0.01, bot.entity.pitch, true)
  }, 30000)
  */

  bot.on('kicked', (reason) => {
    console.log('[Bot] Bị kick:', reason)
  })

  bot.on('error', (err) => {
    console.log('[Bot] Lỗi:', err.message)
  })

  bot.on('end', () => {
    console.log(`[Bot] Mất kết nối, thử lại sau ${CONFIG.reconnectDelay / 1000}s...`)
    setTimeout(createBot, CONFIG.reconnectDelay)
  })
}

createBot()
